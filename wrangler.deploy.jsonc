{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitscore",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/"]
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "SITE_URL": "https://gitscore.mateusz-szostak1.workers.dev"
  }
}
